{
  "name": "airlearner-2.0",
  "version": "2.0.0",
  "description": "Guitar learning app with local AI recommendations",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "build:exe": "npm run build && npx electron-packager . \"Air Learner 2.0\" --out=release --overwrite --platform=win32 --arch=x64 --electron-version=28.3.3 --no-sign",
    "electron:dev": "concurrently \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && electron .\"",
    "build:installer": "npm run build && electron-builder --win --config.extraMetadata.main=dist/main/index.js",
    "electron:build:mac": "npm run build && electron-builder --mac --config",
    "electron:build:linux": "npm run build && electron-builder --linux --config"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "uuid": "^9.0.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.airlearner.app",
    "productName": "Air Learner 2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Air Learner 2.0",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  }
}
